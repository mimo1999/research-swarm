# LLM providers
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Tools
TAVILY_API_KEY=your_tavily_api_key_here

# Observability -- set a real LANGSMITH_API_KEY to enable tracing; the sidebar / research tab
# then show a "view this run's trace" link straight to LangSmith (research_swarm/runtime/langsmith_trace.py).
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=research-swarm

# App settings
DEFAULT_MODEL_PROVIDER=ollama
DEFAULT_MODEL_NAME=gemma4:e2b
DEFAULT_DEPTH=shallow
DATA_DIR=data

# Ollama — local daemon (used for both local and cloud deployments)
# In cloud mode the daemon proxies to Ollama cloud via `ollama login` creds.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b           # local: pulled tag  |  cloud: namespace/model:tag
OLLAMA_DEPLOYMENT=local          # "local" | "cloud"
# Ollama Cloud API key (https://ollama.com/settings/keys). Used by the large model's direct cloud
# endpoint below (planner + writer); sent as a Bearer token on Ollama calls.
OLLAMA_API_KEY=your_ollama_api_key_here

# Research runs locally (the tiers above, gemma4). A larger model guards only the two stages a
# small model does worst -- supervisor (query expansion + plan) and writer -- two to seven calls
# per run. On a GPU that serves a bigger local model, drop the cloud entirely: set LARGE_MODEL=
# (empty) and point the TIER_*_MODEL settings at the bigger model, or set LARGE_MODEL to a local
# tag with LARGE_MODEL_OLLAMA_BASE_URL= (empty, i.e. the local daemon).
LARGE_MODEL_PROVIDER=ollama
LARGE_MODEL=gemma4:31b-cloud
LARGE_MODEL_OLLAMA_BASE_URL=https://ollama.com   # Ollama Cloud directly; "" = OLLAMA_BASE_URL
LARGE_MODEL_STAGES=["supervisor","writer"]
# Per-depth scale (sub-questions, gap-fill workers and rounds, candidates, papers kept, deep
# reads, writer facts) is one JSON setting, DEPTH_PROFILES; see research_swarm/config.py for the
# defaults (shallow / standard / deep = 3 / 5 / 7 sub-questions). Each sub-question costs ~55 s
# of local gemma4 time. Overriding replaces the whole table, e.g.
# DEPTH_PROFILES={"shallow":{"sub_questions":3,"gap_fill_workers":2,"research_rounds":1},...}
WRITER_MODE=sectioned                            # outline -> one call per section -> review | single
# Question frame (probe search + one expansion call before planning); false = plan as asked.
# QUERY_EXPANSION_ENABLED=true
# Full-text passages of the top N arXiv papers added to their abstracts (no LLM call); 0 = off.
# DEEP_READ_PAPERS=2

# In-process transformers provider ("huggingface"; needs a GPU, torch, transformers>=5.5 and
# lm-format-enforcer -- see hf_space/requirements.txt). Point a tier at it with TIER_*_PROVIDER.
# HF_MODEL_ID=google/gemma-4-E2B-it
# HF_MAX_BATCH=6
# HF_BATCH_WINDOW_S=0.3

# Hosted deployment only (e.g. Hugging Face Spaces) — leave unset locally.
# There's no Ollama daemon in a Space container, so every tier's provider
# needs an explicit override; TIER_STANDARD_PROVIDER is also overridden per
# session by the sidebar's provider selection, but TIER_FAST_PROVIDER and
# TIER_THOROUGH_PROVIDER are not, so they'd otherwise still try Ollama.
# See README.md's "Deploy to Hugging Face Spaces" section.
# TIER_FAST_PROVIDER=anthropic
# TIER_STANDARD_PROVIDER=anthropic
# TIER_THOROUGH_PROVIDER=anthropic
# SPACE_MODE=true
# SPACE_RETENTION_SECONDS=21600
# SPACE_MAX_SESSIONS=40
# SPACE_MAX_CONCURRENT_RUNS=4

# LLM concurrency (process-wide, per provider). Ollama Cloud allows ~1 long request at a time per
# account and 429s the rest; hosted APIs tolerate more. 0 = unlimited.
MAX_CONCURRENT_LLM_CALLS_OLLAMA=2
MAX_CONCURRENT_LLM_CALLS_ANTHROPIC=8
MAX_CONCURRENT_LLM_CALLS_OPENAI=8
MAX_CONCURRENT_LLM_CALLS_OLLAMA_CLOUD=2   # the large model's direct Ollama Cloud endpoint
# Stages that run with thinking OFF (JSON list). Remove a stage to turn its thinking back on.
# NO_THINKING_STAGES=["supervisor","expansion","writer","judge","verifier","gap_fill","paper_scout","paper_worker","document_worker"]
