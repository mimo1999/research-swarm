# LLM providers
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Tools
TAVILY_API_KEY=your_tavily_api_key_here

# Observability
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=research-swarm

# App settings
DEFAULT_MODEL_PROVIDER=anthropic
DEFAULT_MODEL_NAME=claude-sonnet-4-6
DEFAULT_DEPTH=standard
MAX_ITERATIONS=10
MAX_SOURCES=15
DATA_DIR=data

# Local RAG — embeddings (no API key needed, downloads once to ~/.cache/huggingface)
EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Ollama — local daemon (used for both local and cloud deployments)
# In cloud mode the daemon proxies to Ollama cloud via `ollama login` creds.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b          # local: pulled tag  |  cloud: namespace/model:tag
OLLAMA_DEPLOYMENT=local          # "local" | "cloud"

# Hosted deployment only (e.g. Hugging Face Spaces) — leave unset locally.
# There's no Ollama daemon in a Space container, so every tier's provider
# needs an explicit override; TIER_STANDARD_PROVIDER is also overridden per
# session by the sidebar's provider selection, but TIER_FAST_PROVIDER and
# TIER_THOROUGH_PROVIDER are not, so they'd otherwise still try Ollama.
# See README.md's "Deploy to Hugging Face Spaces" section.
# TIER_FAST_PROVIDER=anthropic
# TIER_STANDARD_PROVIDER=anthropic
# TIER_THOROUGH_PROVIDER=anthropic
# SPACE_MODE=true
# SPACE_RETENTION_SECONDS=21600
# SPACE_MAX_SESSIONS=40
# SPACE_MAX_CONCURRENT_RUNS=4
